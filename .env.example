# Copy this file to ".env" (in the project folder) and paste your keys after the "=".
# .env is listed in .gitignore, so it is never committed. Never paste keys into a chat.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional, demo only. If Groq is rate-limited the web app tries these, in this order.
# Free keys: https://build.nvidia.com (NVIDIA_API_KEY) and https://openrouter.ai/keys (OPENROUTER_API_KEY)
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# React Bits Pro License Key (https://pro.reactbits.dev)
REACTBITS_LICENSE_KEY=
